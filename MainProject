
import math
import random
import time
from abc import ABC, abstractmethod

import pygame
pygame.init()
pygame.font.init()
pygame.mixer.init()


# --- Constants -----------------------------------------------------------------

WIDTH = 640
HEIGHT = 480

WIN = pygame.display.set_mode((WIDTH, HEIGHT), pygame.SRCALPHA)
pygame.display.set_caption("Blind Faith")

BG = pygame.transform.scale(pygame.image.load("background.png"), (WIDTH, HEIGHT))
Dark = pygame.transform.scale(pygame.image.load("dark.png").convert_alpha(), (WIDTH, HEIGHT))

PLAYER_WIDTH = 42
PLAYER_HEIGHT = 48
PLAYER_VELOCITY = 2

ROCK_WIDTH = 16
ROCK_VELOCITY = 1.5

FONT = pygame.font.SysFont("comicsans", 30)

Music = 'quietgame.mp3'

surface = pygame.Surface((WIDTH, HEIGHT), pygame.SRCALPHA)

def draw(player, elapsed_time, rocks, bar, alpha):
    WIN.blit(BG, (0, 0))

    for rock in rocks:
        pygame.draw.rect(WIN, "black", rock)

    pygame.draw.rect(WIN, Dark, player)

    Dark.set_alpha(alpha)
    WIN.blit(Dark, (0, 0))

    time_text = FONT.render(f"Time: {round(elapsed_time)}s", 1, "white")
    WIN.blit(time_text, (10, 10))

    pygame.draw.rect(WIN, "green", bar)

    pygame.display.update()
    

def main():
    pygame.mixer.music.load(Music)
    pygame.mixer.music.play(-1)
    flashlight = pygame.mixer.Sound('Flashlight.wav')
    flashlight.set_volume(0.35)
    death = pygame.mixer.Sound('Dead.wav')
    death.set_volume(0.2)

    run = True

    player = pygame.Rect(((WIDTH/2)- (PLAYER_WIDTH/2)), (HEIGHT - PLAYER_HEIGHT), PLAYER_WIDTH, PLAYER_HEIGHT)

    clock = pygame.time.Clock()

    start_time = time.time()
    elapsed_time = 0

    rock_add_increment = 3000
    rock_count = 3000

    rocks = []
    hit = False

    alpha = 255

    abilitymeter = 100
    abilitygain = True
    countdown = 0
    pygame.mixer.music.set_volume(0.15)
    volume = 0.15

    rock_drop = ROCK_VELOCITY

    while run:
        rock_count += clock.tick(60)
        elapsed_time = time.time() - start_time
        
        if rock_count > rock_add_increment:
            for _ in range(1):
                rock_x = random.randint(0, WIDTH - ROCK_WIDTH)
                rock = pygame.Rect(rock_x, -30, ROCK_WIDTH, ROCK_WIDTH)
                rocks.append(rock)
            
            rock_add_increment = max(100, rock_add_increment - (rock_add_increment/20))
            rock_drop = min(2.5, rock_drop + 0.005)
            rock_count = 0

        for event in pygame.event.get():
            if event.type == pygame.QUIT:
                run = False
                break

        keys = pygame.key.get_pressed()

        if keys[pygame.K_LEFT] and player.x - PLAYER_VELOCITY >= 0:
            player.x -= PLAYER_VELOCITY

        if keys[pygame.K_RIGHT] and player.x + PLAYER_VELOCITY + player.width <= WIDTH:
            player.x += PLAYER_VELOCITY
        
        for rock in rocks[:]:
            rock.y += rock_drop
            if rock.y > HEIGHT:
                rocks.remove(rock)
            elif rock.y + rock.height >= player.y and rock.colliderect(player):
                rocks.remove(rock)
                hit = True
                break
        
        if hit:
            pygame.mixer.music.pause()
            lost_text = FONT.render("YOU LOST!", 1, "white")
            WIN.blit(lost_text, (WIDTH/2 - lost_text.get_width()/2, HEIGHT/2 - lost_text.get_height()/2))
            pygame.display.update()
            death.play()
            pygame.time.delay(4000)
            break

        bar = pygame.Rect(WIDTH - 120, 20, (abilitymeter), 20)
        if abilitymeter < 100 and abilitygain == True:
            abilitymeter += 0.4
            alpha += 4
            if (volume >= 0.15):
                volume -= 0.005
        
        if keys[pygame.K_SPACE] and abilitymeter >= 50 and abilitygain == True:
            abilitymeter -= 50
            abilitygain = False
            alpha = 0
            countdown = time.time()
            volume = 0.8
            flashlight.play()

        if countdown <= time.time() - 1:
            abilitygain = True
        
        pygame.mixer.music.set_volume(volume)

        draw(player, elapsed_time, rocks, bar, alpha)

    
    pygame.quit()

if __name__ == "__main__":
    main()